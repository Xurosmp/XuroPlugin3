+    /** Ersetzt eine alte Spieler-UUID in allen Clans durch die neue (siehe data.migrate-by-name). */
+    public void migrate(UUID old, UUID now) {
+        boolean changed = false;
+        for (Clan c : clans.values()) {
+            if (c.leader.equals(old)) { c.leader = now; changed = true; }
+            Role r = c.members.remove(old);
+            if (r != null) { c.members.put(now, r); byPlayer.remove(old); byPlayer.put(now, c.id); changed = true; }
+        }
+        if (changed) save(true);
+    }
