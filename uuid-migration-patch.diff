+    /**
+     * Notfall-Übernahme: Hat ein Spieler eine neue UUID (z.B. nach Wechsel von Online-/Offline-Modus oder Proxy),
+     * wird sein alter Eintrag über den Namen gefunden und auf die neue UUID umgeschrieben (inkl. Clan).
+     * Nur aktiv mit data.migrate-by-name: true in der config.yml. Danach wieder auf false stellen!
+     */
+    private PlayerData migrateByName(UUID id, String name) {
+        UUID old = names.get(name.toLowerCase(Locale.ROOT));
+        if (old == null || old.equals(id)) return null;
+        PlayerData od = players.remove(old);
+        if (od == null) return null;
+        PlayerData nd = new PlayerData(id, name);
+        nd.money = od.money; nd.crystals = od.crystals; nd.gems = od.gems;
+        nd.kills = od.kills; nd.deaths = od.deaths; nd.playtime = od.playtime;
+        nd.lastDaily = od.lastDaily; nd.dailyStreak = od.dailyStreak;
+        nd.scoreboardOff = od.scoreboardOff; nd.signDay = od.signDay; nd.signCount = od.signCount;
+        nd.rank = od.rank;
+        nd.kitUsed.putAll(od.kitUsed); nd.keys.putAll(od.keys); nd.homes.putAll(od.homes);
+        players.put(id, nd);
+        names.put(name.toLowerCase(Locale.ROOT), id);
+        plugin.clans().migrate(old, id);
+        plugin.getLogger().info("Daten von " + name + " von " + old + " auf " + id + " übernommen.");
+        return nd;
+    }
