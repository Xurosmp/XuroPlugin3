+# /sell: Verkaufspreise für ALLE Items, auch wenn sie nicht im /shop stehen.
+# Reihenfolge (das Spätere gewinnt): default-price -> patterns -> prices.
+# Steht ein Item im /shop mit sell > 0, gilt IMMER der Preis aus der shop.yml.
+# Items mit Namen/Verzauberungen/Lore werden weiterhin nicht verkauft.
+# Preis 0 = nicht verkaufbar. Änderungen: /smpcore reload.
+#
+# ACHTUNG (Dupe-/Gewinn-Falle): Preis eines Endprodukts nie höher als die Summe der Zutaten setzen,
+# sonst kann man durch Craften Geld drucken (z.B. 1 Log -> 4 Bretter).
+enabled: true
+default-price: 0.5
+
+# Muster: "*_LOG" = alles was auf _LOG endet, "RAW_*" = alles was mit RAW_ beginnt
+patterns:
+  "*_LOG": 2
+  "*_WOOD": 2
+  "*_PLANKS": 0.5
+  "*_STAIRS": 0.5
+  "*_SLAB": 0.25
+  "*_WOOL": 2
+  "*_SPAWN_EGG": 0
+  "*_SMITHING_TEMPLATE": 100
+  "MUSIC_DISC_*": 200
+
