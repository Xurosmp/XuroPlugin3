+    /** Liest sell.yml: Preise für alle Items (Standardpreis, Muster wie *_LOG, Einzelpreise, Blacklist). */
+    private void loadSell() {
+        allSell.clear();
+        File f = new File(plugin.getDataFolder(), "sell.yml");
+        if (!f.exists()) plugin.saveResource("sell.yml", false);
+        YamlConfiguration y = YamlConfiguration.loadConfiguration(f);
+        if (!y.getBoolean("enabled", true)) return;
+        double def = y.getDouble("default-price", 0.5);
+        Set<String> black = new HashSet<>();
+        for (String b : y.getStringList("blacklist")) black.add(b.toUpperCase(Locale.ROOT));
+        ConfigurationSection pa = y.getConfigurationSection("patterns");
+        ConfigurationSection pr = y.getConfigurationSection("prices");
+        for (Material m : Material.values()) {
+            if (m.isLegacy() || m.isAir() || !m.isItem() || black.contains(m.name())) continue;
+            double price = def;
+            if (pa != null) {
+                for (String k : pa.getKeys(false)) {
+                    String key = k.toUpperCase(Locale.ROOT);
+                    boolean hit = key.startsWith("*") ? m.name().endsWith(key.substring(1))
+                            : key.endsWith("*") && m.name().startsWith(key.substring(0, key.length() - 1));
+                    if (hit) price = pa.getDouble(k);
+                }
+            }
+            if (pr != null && pr.contains(m.name())) price = pr.getDouble(m.name());
+            if (price > 0) allSell.put(m, price);
+        }
+    }
+
